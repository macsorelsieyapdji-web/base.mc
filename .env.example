# --- Supabase (routes /health/supabase) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=<clé anon ou publishable>

# --- PostgreSQL : Supabase > bouton "Connect" > chaîne de connexion ---
# Connexion directe :
DB_HOST=db.<ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER_SUFFIX=
# Si votre réseau est en IPv4 uniquement, utilisez le pooler "Session" à la place :
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_USER_SUFFIX=.<ref>

# Utilisateurs SQL créés par la partie C (sql/03_securite.sql)
AGENT_USER=agent_alice
AGENT_PASSWORD=alice_pwd
CONTROLEUR_USER=controleur_bob
CONTROLEUR_PASSWORD=bob_pwd