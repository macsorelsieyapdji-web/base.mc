# Copier ce fichier en .env (jamais commité) et remplir.

# --- Option 1 : base locale (Docker pg-test, voir README) ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=postgres
DB_USER_SUFFIX=
DB_SSLMODE=disable

# --- Option 2 : Supabase > bouton "Connect" > chaîne de connexion ---
# Connexion directe :
#   DB_HOST=db.<ref>.supabase.co
#   DB_PORT=5432
#   DB_NAME=postgres
#   DB_USER_SUFFIX=
#   DB_SSLMODE=require
# Si votre réseau est en IPv4 uniquement, utilisez le pooler "Session" :
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_USER_SUFFIX=.<ref>
# Route /health/supabase (facultative) :
#   SUPABASE_URL=https://<ref>.supabase.co
#   SUPABASE_KEY=<clé anon ou publishable>

# Utilisateurs SQL créés par sql/03_securite.sql
# Poser les mots de passe avec : ALTER ROLE agent_alice PASSWORD '...';
AGENT_USER=agent_alice
AGENT_PASSWORD=alice_pwd
CONTROLEUR_USER=controleur_bob
CONTROLEUR_PASSWORD=bob_pwd
